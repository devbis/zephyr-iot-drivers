config IOTDRV_DISPLAY_CGDK2
	bool "CGDK2 segment display"
	default y
	depends on DT_HAS_IOTDRV_CGDK2_LCD_ENABLED
	select I2C
	help
	  Segment LCD of the Qingping CGDK2 (ROHM BU9792AFUV controller).
	  Enabled by a "iotdrv,cgdk2-lcd" node in the devicetree.

if IOTDRV_DISPLAY_CGDK2

config IOTDRV_DISPLAY_CGDK2_INIT_PRIORITY
	int "Init priority"
	default 90
	help
	  Must be later than the I2C driver the panel sits on.

endif # IOTDRV_DISPLAY_CGDK2
