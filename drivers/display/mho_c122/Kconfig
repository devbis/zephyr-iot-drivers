config IOTDRV_DISPLAY_MHO_C122
	bool "MHO-C122 segment display"
	default y
	depends on DT_HAS_IOTDRV_MHO_C122_LCD_ENABLED
	select I2C
	help
	  Segment LCD of the Xiaomi MHO-C122. Enabled by a
	  "iotdrv,mho-c122-lcd" node in the devicetree.

if IOTDRV_DISPLAY_MHO_C122

config IOTDRV_DISPLAY_MHO_C122_INIT_PRIORITY
	int "Init priority"
	default 90
	help
	  Must be later than the I2C driver the panel sits on.

endif # IOTDRV_DISPLAY_MHO_C122
